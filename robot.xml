<mujoco model="differential_drive_robot">
    <compiler angle="radian" />
    
    <asset>
        <mesh name="base" file="meshes/base.stl" scale="0.001 0.001 0.001" />
        <mesh name="left_wheel" file="meshes/left_wheel.stl" scale="0.001 0.001 0.001" />
        <mesh name="right_wheel" file="meshes/right_wheel.stl" scale="0.001 0.001 0.001" />
        <mesh name="imu" file="meshes/imu.stl" scale="0.001 0.001 0.001" />
    </asset>

    <worldbody>
        <!-- Standard directional light and ground plane -->
        <light directional="true" pos="-0.5 0.5 3" dir="0 0 -1" />
        <geom pos="0 0 0" size="5 5 1" type="plane" rgba="1 0.83 0.61 0.5" />

        <body name="base" pos="0.0 0.0 0.05">
            <freejoint name="root"/> 
            <geom name="base_geom" type="mesh" mesh="base" />
            <inertial mass="3.925" pos="0.0 0.0 0.025" fullinertia="0.004088 0.004088 0.006541 0 0 0" />

            <body name="left_wheel" pos="0.0 0.05 0.0">
                <joint name="left_wheel_joint" type="hinge" axis="0 1 0" pos="0 0 0" />
                <geom name="left_wheel_geom" type="mesh" mesh="left_wheel" />
                <inertial mass="0.154" pos="0.0 0.005 0.0" fullinertia="2.53e-05 4.81e-05 2.53e-05 0 0 0" />
            </body>

            <body name="right_wheel" pos="0.0 -0.06 0.0">
                <joint name="right_wheel_joint" type="hinge" axis="0 1 0" pos="0 0.01 0.0" />
                <geom name="right_wheel_geom" type="mesh" mesh="right_wheel" />
                <inertial mass="0.154" pos="0.0 0.005 0.0" fullinertia="2.53e-05 4.81e-05 2.53e-05 0 0 0" />
            </body>

            <body name="imu" pos="0.0 0.0 0.05">
                <geom name="imu_geom" type="mesh" mesh="imu" />
                <inertial mass="0.00157" pos="0.0 0.0 0.001" fullinertia="1.36e-08 1.36e-08 2.61e-08 0 0 0" />
                
                <!-- This site acts as the physical anchor location for your IMU sensors -->
                <site name="imu_site" pos="0 0 0" size="0.005"/>
            </body>
        </body>
    </worldbody>

    <!-- . SPECIFIED WHEEL & IMU SENSORS -->
    <sensor>
        <!-- Wheel Positions (Joint angles in radians) -->
        <jointpos name="left_wheel_pos" joint="left_wheel_joint"/>
        <jointpos name="right_wheel_pos" joint="right_wheel_joint"/>

        <!-- Wheel Velocities (Joint speed in rad/s) -->
        <jointvel name="left_wheel_vel" joint="left_wheel_joint"/>
        <jointvel name="right_wheel_vel" joint="right_wheel_joint"/>

        <!-- IMU Sensors (Accelerometers & Gyroscopes bound to the imu_site) -->
        <accelerometer name="imu_accel" site="imu_site"/>
        <gyro name="imu_gyro" site="imu_site"/>
    </sensor>
    <actuator>
        <motor name="left_motor" joint="left_wheel_joint" gear="1.0" ctrlrange="-1 1" ctrllimited="true"/>
        <motor name="right_motor" joint="right_wheel_joint" gear="1.0" ctrlrange="-1 1" ctrllimited="true"/>
    </actuator>
</mujoco>
